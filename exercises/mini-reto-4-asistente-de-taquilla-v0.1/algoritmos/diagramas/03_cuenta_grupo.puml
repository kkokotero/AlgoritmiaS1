@startuml
title Cuenta del grupo — Asistente de taquilla v0.1

start
:Inicializar precio por hora\ny porcentaje de aporte;
:Leer cantidad de bicicletas,\nhoras, precio del recorrido\ny cantidad de personas;
:ValorAlquiler <- bicicletas * horas\n* PrecioPorHoraBicicleta;
:ValorRecorrido <- precio por persona\n* cantidad de personas;
:Subtotal <- valor alquiler\n+ valor recorrido;
:AporteVoluntario <- Subtotal\n* PorcentajeAporte;
:TotalGrupo <- Subtotal\n+ aporte voluntario;
:ValorExactoPorPersona <-\nTotalGrupo / cantidad de personas;
:Redondear valor individual hacia arriba\na la centena usando Trunc;
:Mostrar alquiler, recorrido, subtotal,\naporte, total y valor por persona;
stop

@enduml
